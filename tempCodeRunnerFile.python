import asyncio
from telegram import Bot
from dotenv import load_dotenv
import os

load_dotenv()
TOKEN = os.environ["API_TELEGRAM"]
CHAT_ID = os.environ["TELEGRAM_CHAT_ID"]

async def envoyer_message(texte: str):
    bot = Bot(token=TOKEN)
    await bot.send_message(chat_id=CHAT_ID, text=texte)

asyncio.run(envoyer_message("Test depuis mon bot LBC 🖥️"))